# PostgreSQL (use a pooled URL for Vercel/serverless deployments)
DATABASE_URL="postgresql://user:password@localhost:5432/poketierlist"

# Auth.js - generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional OAuth providers. Credentials login works without these.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Operator-only input for `npm run admin:promote-first` after registering the account.
ADMIN_EMAIL="operator@example.com"
